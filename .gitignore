# Node / TS
node_modules/
dist/
*.tsbuildinfo
.env
.env.*
!.env.example

# Bitburner build output (we rebuild from the pinned submodule each run)
bitburner/src/dist/
bitburner/src/node_modules/
bitburner/src/.app/

# Logs
*.log
logs/

# Editor / OS
.DS_Store
.idea/
.vscode/

# Puppeteer / Chromium cache
.chromium-cache/

# Nothing in results/ is ignored; run artifacts are the product.
# Each run commits its own results/<run_id>/ directory.

# run.yaml is per-run and not committed; run.example.yaml is the template.
config/run.yaml

# SQLite WAL and shared-memory sidecars — not part of the commit artifact;
# state.db itself is what we record once the run checkpoints on close.
results/**/state.db-wal
results/**/state.db-shm
