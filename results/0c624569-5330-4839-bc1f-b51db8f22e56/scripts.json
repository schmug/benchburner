    "instruction_id": "07876752-e284-4324-b219-6f2d2121a98f",
    "code": "/** @param {NS} ns */\nexport async function main(ns) {\n  const rootedServers = new Set();\n  const portOpeners = [];\n  \n  // Check for port openers\n  if (ns.fileExists('BruteSSH.exe')) portOpeners.push(() => ns.brutessh);\n  if (ns.fileExists('FTPCrack.exe')) portOpeners.push(() => ns.ftpcrack);\n  if (ns.fileExists('relaySMTP.exe')) portOpeners.push(() => ns.relaysmtp);\n  if (ns.fileExists('HTTPWorm.exe')) portOpeners.push(() => ns.httpworm);\n  if (ns.fileExists('SQLInject.exe')) portOpeners.push(() => ns.sqlinject);\n  \n  let target = 'n00dles';\n  const queue = ['home'];\n  const visited = new Set(['home']);\n  \n  // BFS to discover all servers\n  while (queue.length > 0) {\n    const srv = queue.shift();\n    const neighbors = ns.scan(srv);\n    for (const next of neighbors) {\n      if (!visited.has(next)) {\n        visited.add(next);\n        queue.push(next);\n      }\n    }\n  }\n  \n  // Attempt root on all servers\n  for (const srv of visited) {\n    if (ns.hasRootAccess(srv)) {\n      rootedServers.add(srv);\n    } else {\n      const ports = ns.getServerNumPortsRequired(srv);\n      for (let i = 0; i < Math.min(ports, portOpeners.length); i++) {\n        portOpeners[i]()(srv);\n      }\n      if (ports <= portOpeners.length) {\n        ns.nuke(srv);\n        rootedServers.add(srv);\n      }\n    }\n  }\n  \n  let hackCount = 0, weakenCount = 0, growCount = 0;\n  const minHackLevel = ns.getHackingLevel();\n  \n  while (true) {\n    // Find best rooted target\n    let best = null, bestMoney = 0;\n    for (const srv of rootedServers) {\n      const reqLevel = ns.getServerRequiredHackingLevel(srv);\n      if (reqLevel <= minHackLevel) {\n        const money = ns.getServerMoneyAvailable(srv);\n        if (money > bestMoney) {\n          bestMoney = money;\n          best = srv;\n        }\n      }\n    }\n    \n    if (!best) {\n      target = 'n00dles';\n      best = 'n00dles';\n    } else {\n      target = best;\n    }\n    \n    // Weaken/grow/hack loop\n    const sec = ns.getServerSecurityLevel(target);\n    const minSec = ns.getServerMinSecurityLevel(target);\n    const money = ns.getServerMoneyAvailable(target);\n    const maxMoney = ns.getServerMaxMoney(target);\n    \n    if (sec > minSec + 5) {\n      await ns.weaken(target);\n      weakenCount++;\n    } else if (money < maxMoney * 0.75) {\n      await ns.grow(target);\n      growCount++;\n    } else {\n      await ns.hack(target);\n      hackCount++;\n    }\n    \n    if ((hackCount + weakenCount + growCount) % 10 === 0) {\n      ns.print(`[${target}] hack=${hackCount} weaken=${weakenCount} grow=${growCount}`);\n    }\n  }\n}",
