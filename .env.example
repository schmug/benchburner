# Copy to .env (gitignored) and source before `npm run harness`.
#
# Puppeteer uses the system Chrome instead of downloading its own bundled
# Chromium — required in environments that block egress to
# storage.googleapis.com. See harness/game/README.md.
PUPPETEER_SKIP_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Ollama endpoint (optional override if not at the default).
# OLLAMA_ENDPOINT=http://localhost:11434

# HTTPAdapter API keys (referenced per-model in config/models.yaml).
# Get from https://openrouter.ai/keys — separate billing from any
# Claude.ai / ChatGPT / Gemini subscription. A 1-hour Claude-Opus run
# of the harness typically costs single-digit dollars; budget
# accordingly.
# OPENROUTER_API_KEY=sk-or-v1-...
#
# TOGETHER_API_KEY=sk-...
